{
      "description": "Validate Spec-Flow authorization and task scope for supported local patch writes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/check-phase-approval.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
